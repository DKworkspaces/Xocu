js

document.addEventListener("DOMContentLoaded", () => {
    // === 1. AUTOMATIC REAL-TIME SLUG GENERATOR ===
    // Maps standard name fields directly to their corresponding slug targets
    const slugMappings = [
        { sourceId: "title", targetId: "slug" },    // Blog Post form
        { sourceId: "t-name", targetId: "t-slug" }, // Topic form
        { sourceId: "c-name", targetId: "c-slug" }, // Category form
        { sourceId: "tag-name", targetId: "tag-slug" } // Tag form
    ];

    slugMappings.forEach(({ sourceId, targetId }) => {
        const sourceInput = document.getElementById(sourceId);
        const targetInput = document.getElementById(targetId);

        if (sourceInput && targetInput) {
            sourceInput.addEventListener("input", () => {
                targetInput.value = sourceInput.value
                    .toLowerCase()
                    .trim()
                    .replace(/[^\w\s-]/g, "") // Remove special characters
                    .replace(/[\s_-]+/g, "-") // Replace spaces/underscores with dashes
                    .replace(/^-+|-+\$/g, ""); // Trim dashes from ends
            });
        }
    });

    // === 2. URL PARAMETER CHECKER (PRE-FILL FOR EDITING) ===
    const urlParams = new URLSearchParams(window.location.search);
    
    // Check if '?edit=...' is present in the browser address bar
    if (urlParams.has("edit")) {
        console.log("Edit mode triggered for record ID:", urlParams.get("edit"));
        
        // Target form header text elements to show "Update" instead of "Add/Create"
        const formHeader = document.querySelector("form h3");
        const submitButton = document.querySelector("form button[type='submit']");
        
        if (formHeader) formHeader.textContent = "Update Existing Record";
        if (submitButton) submitButton.textContent = "Apply Changes";

        // MOCK DATA: In a complete application, your backend framework usually outputs this data.
        // For testing, this demonstrates form populate logic automatically.
        const mockData = {
            title: "10 Tips for Web Design",
            slug: "10-tips-web-design",
            content: "This is the body content loaded directly from the database record configuration.",
            name: "Artificial Intelligence",
            desc: "A brief summary field description value details.",
            wikipedia_url: "https://wikipedia.org",
            wikidata_url: "https://wikidata.org",
            type: "Concept"
        };

        // Automatically matches mock fields to any available layout inputs on the page
        Object.keys(mockData).forEach(key => {
            // Check matching input names or IDs
            const field = document.querySelector(`[name="${key}"]`) || document.getElementById(key);
            if (field && field.type !== "file") {
                field.value = mockData[key];
            }
        });
    }
});



link to html like this

    <!-- Place right above your closing body tag -->
    <script src="dashboard.js"></script>
</body>
</html>



