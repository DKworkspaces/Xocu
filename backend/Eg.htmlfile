<!DOCTYPE html><html lang="en"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Panel</title>
<link rel="stylesheet" href="style.css">
</head><body>
<div class="sidebar"><h2>CMS Dashboard</h2>
<nav id="main-navigation">
<a href="#home" class="nav-item">Blog Post</a>
<a href="#topic" class="nav-item">Topic</a>
<a href="#category" class="nav-item">Category</a>
<a href="#tag" class="nav-item">Tag</a>
</nav></div>

<div class="main-content">
<section id="view-home" class="spa-view" data-title="CMS Panel"><h2>Home Workspace</h2></section>
<section id="view-topic" class="spa-view" data-title="Topics Directory — CMS Panel"><h2>Topic Workspace</h2></section>
<section id="view-category" class="spa-view" data-title="Categories Directory — CMS Panel"><h2>Category Workspace</h2></section>
<section id="view-tag" class="spa-view" data-title="Tags Directory — CMS Panel"><h2>Tag Workspace</h2></section>
