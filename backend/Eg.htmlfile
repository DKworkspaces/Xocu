generateFieldHTML("title", "Title", "text", true)
generateFieldHTML("desc", "Description", "textarea", true)
generateFieldHTML("subscribe", "Subscribe to notifications?", "checkbox", false)

generateFormWrapperHTML("create_post","/submit-post", "POST", false, innerFieldsHTML, "Create New")
generateFormWrapperHTML("edit_post","/edit-post", "PUT", false, innerFieldsHTML, "Save Changes")

function handleFormSubmit(event) {
    event.preventDefault();
    const submittedForm = event.target;
    const formId = submittedForm.id;
    const submitButton = form.querySelector('button[type="submit"]');
    const formData = new FormData(submittedForm);
    const jsonPayload = Object.fromEntries(formData.entries());
    submitButton.disabled = true;
    try {
        const response = await fetch(form.action, {method: form.method || 'POST',headers: {'Content-Type': 'application/json','Accept': 'application/json'},body: JSON.stringify(jsonPayload)});
        if (!response.ok) {throw new Error(`Server returned status code: ${response.status}`);}
        const result = await response.json();
        console.log(`Success response from ${form.id}:`, result);
        alert("Data successfully sent as JSON! Check dev console to see details.");
        form.reset();
    } catch (error) {
        console.error(`Error submitting ${form.id}:`, error);
        alert(`Submission failed: ${error.message}`);
    } finally {submitButton.disabled = false;}



    if (formId === "blog-form") {
        console.log("Blog Title:", formData.get("postTitle"));
        alert("New entry created!");
    }
    else if (formId === "profile-form") {
        console.log("Name Updated:", formData.get("fullName"));
        alert("Changes saved successfully!");
    }
}



<form action="/submit-post" method="POST" enctype="multipart/form-data">
<h3>Create Blog Post</h3>
<div class="field">
    <label for="title">Title</label>
    <input type="text" id="title" name="title" required>
</div>
<div class="field">
    <label for="content">Body Content</label>
    <textarea id="content" name="content" rows="6" required></textarea>
</div>
<div class="field">
    <label for="image">Featured Image</label>
    <input type="file" id="image" name="featured_image" accept="image/*">
</div>
<button type="submit">Publish Post</button>
</form></div>

<form action="/submit-topic" method="POST">
    <h3>Add New Topic</h3>
    <div class="field">
        <label for="wiki">Wikipedia URL</label>
        <input type="url" id="wiki" name="wikipedia_url">
    </div>
    <div class="field">
        <label for="t-type">Type</label>
        <input type="text" id="t-type" name="type" placeholder="e.g., Concept, Person">
    </div>
</form></div>
<form action="/submit-category" method="POST">
    <h3>Add New Category</h3>
    <div class="field">
        <label for="parent">Parent Category</label>
        <select id="parent" name="parent_id">
            <option value="">None (Root Category)</option>
            <option value="1">Technology</option>
            <option value="2">Design</option>
        </select>
    </div>
    <button type="submit">Save Category</button>
</form></div>





