<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CMS Dashboard - Topics</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div class="sidebar">
        <h2>CMS Dashboard</h2>
        <nav>
            <a href="dashboard.html">Blog Post</a>
            <a href="topic.html" class="active">Topic</a>
            <a href="category.html">Category</a>
            <a href="tag.html">Tag</a>
        </nav>
    </div>

    <div class="main-content">
        <form action="/submit-topic" method="POST">
            <h3>Add New Topic</h3>
            <div class="field">
                <label for="t-name">Name</label>
                <input type="text" id="t-name" name="name" required>
            </div>
            <div class="field">
                <label for="t-slug">Slug</label>
                <input type="text" id="t-slug" name="slug" required>
            </div>
            <div class="field">
                <label for="t-desc">Description</label>
                <textarea id="t-desc" name="desc" rows="3"></textarea>
            </div>
            <div class="field">
                <label for="wiki">Wikipedia URL</label>
                <input type="url" id="wiki" name="wikipedia_url">
            </div>
            <div class="field">
                <label for="wikidata">Wikidata URL</label>
                <input type="url" id="wikidata" name="wikidata_url">
            </div>
            <div class="field">
                <label for="t-type">Type</label>
                <input type="text" id="t-type" name="type" placeholder="e.g., Concept, Person">
            </div>
            <button type="submit">Save Topic</button>
        </form>
    </div>

</body>
</html>

