<?xml version="1.0" encoding="UTF-8" ?>
<rss version="2.0" xmlns:atom="http://w3.org">
<channel>
    <title>{{ web.site_name }}</title>
    <link>{{ web.site_url }}</link>
    <description>{{ web.site_desc }}</description>
    <language>{{ web.site_lang | default('en-US') }}</language>
    <lastBuildDate>{{ build_date }}</lastBuildDate>
    <atom:link href="{{ web.site_url }}/feed.xml" rel="self" type="application/rss+xml" />
    
    {% for item in items %}
    <item>
        <title>{{ item.title }}</title>
        <link>{{ web.site_url }}{{ item.url }}</link>
        <guid isPermaLink="true">{{ web.site_url }}{{ item.url }}</guid>
        <pubDate>{{ item.date_rss }}</pubDate>
        <description><![CDATA[{{ item.content }}]]></description>
        {% if item.author %}
        <author>{{ item.author }}</author>
        {% endif %}
    </item>
    {% endfor %}
</channel>
</rss>
