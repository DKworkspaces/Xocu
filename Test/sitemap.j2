<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://sitemaps.org">
    
    <!-- 1. Core Pages (Homepage, About, Contact, Policy) -->
    {% for page in items.static_pages %}
    <url>
        <loc>{{ web.site_url }}/{{ page.slug }}</loc>
        <changefreq>{{ page.changefreq }}</changefreq>
        <priority>{{ page.priority }}</priority>
    </url>
    {% endfor %}

    <!-- 2. Topic Clusters -->
    {% for cluster in items.topic_clusters %}
    
    <!-- Main Pillar Page -->
    <url>
        <loc>{{ web.site_url }}/{{ cluster.pillar_slug }}</loc>
        {% if cluster.updated_at %}<lastmod>{{ cluster.updated_at }}</lastmod>{% endif %}
        <changefreq>weekly</changefreq>
        <priority>{{ cluster.priority }}</priority>
    </url>
    
    <!-- Related Cluster Sub-Topics -->
    {% for sub in cluster.sub_topics %}
    <url>
        <loc>{{ web.site_url }}/{{ sub.slug }}</loc>
        {% if sub.updated_at %}<lastmod>{{ sub.updated_at }}</lastmod>{% endif %}
        <changefreq>weekly</changefreq>
        <priority>0.6</priority> <!-- Slightly lower priority than the pillar -->
    </url>
    {% endfor %}
    
    {% endfor %}
    <!-- Posts (Flat URLs) -->
    {% for post in items.posts %}
    <url>
        <loc>{{ web.site_url }}/{{ post.slug }}/</loc>
        {% if post.updated_at %}<lastmod>{{ post.updated_at }}</lastmod>{% endif %}
        <changefreq>weekly</changefreq>
        <priority>0.6</priority>
    </url>
    {% endfor %}

</urlset>
