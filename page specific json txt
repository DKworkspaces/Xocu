class SiteConfig:
    name: str = "EnterpriseFlask"
    separator: str = "|"
    founder: FounderConfig = field(default_factory=lambda: FounderConfig(
        id="founder-id",
        name="John Doe",
        url="/team/john",
        job_title="CEO",
        knowsAbout=["Flask", "Python"],
        social_links=["https://twitter.com"]
    ))
    authors: List[AuthorConfig] = field(default_factory=lambda: [
        AuthorConfig(slug="jane-smith", name="Jane Smith", title="Lead Arch", knowsAbout=["Docker"], social_links=[], url="/team/jane"),
        AuthorConfig(slug="alex-jones", name="Alex Jones", title="DevOps", knowsAbout=["AWS"], social_links=[])
    ])





    breadcrumb = [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": base_url },
    { "@type": "ListItem", "position": 2, "name": "About Us", "item": request.url.rstrip('/') }
]

# 3. Build Authors List (Lazy senior approach: merge logic elegantly)
founder_data = {
    'id': site_config.founder.id,
    'name': site_config.founder.name,
    'url': f"{base_url}{site_config.founder.url}",
    'image': "founder.jpg",
    'job_title': site_config.founder.job_title,
    'knowsAbout': site_config.founder.knowsAbout,
    'social_links': site_config.founder.social_links
}

authors_list = [founder_data]

for author in site_config.authors:
    author_data = {
        'id': author.slug,
        'name': author.name,
        'image': f"{author.slug}.jpg",
        'job_title': author.title,
        'knowsAbout': author.knowsAbout,
        'social_links': author.social_links
    }
    if author.url:
        author_data['url'] = f"{base_url}{author.url}"
        
    authors_list.append(author_data)

# 4. Final Page Data Dictionary
